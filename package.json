{
  "name": "dsh-asl-workspace",
  "version": "0.3.15",
  "description": "DeepSeek Harness 原生工作区，复用 ASL App 的 Mermaid 编辑画板",
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "host.js",
    "domain.cjs",
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "README_EN.md",
    "UPSTREAM.md",
    "docs",
    "assets/workspace.png"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "dompurify": "3.4.17",
    "lucide-react": "1.43.0",
    "marked": "16.4.2",
    "mermaid": "12.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qihangzhang-272/dsh-asl.git"
  },
  "homepage": "https://github.com/qihangzhang-272/dsh-asl",
  "bugs": {
    "url": "https://github.com/qihangzhang-272/dsh-asl/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "asl",
    "skills",
    "mermaid",
    "workspace"
  ],
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
